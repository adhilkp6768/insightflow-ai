# Copy to .env before `docker compose up`. Replace JWT_SECRET before any shared deployment.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://insightflow:insightflow@localhost:5432/insightflow
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_ENABLED=true
JOBS_INLINE=false
LOG_LEVEL=INFO
DATA_DIR=data
MAX_UPLOAD_BYTES=104857600
INSIGHTFLOW_LLM_API_KEY=
INSIGHTFLOW_LLM_BASE_URL=https://api.openai.com/v1
INSIGHTFLOW_LLM_MODEL=gpt-4o-mini
